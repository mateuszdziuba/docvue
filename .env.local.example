# Supabase Configuration
# Server-side (server functions, SSR)
SUPABASE_URL=your-project-url
SUPABASE_ANON_KEY=your-anon-key

# Client-side (browser, must be prefixed with VITE_)
VITE_SUPABASE_URL=your-project-url
VITE_SUPABASE_ANON_KEY=your-anon-key

# Service Role Key (for admin operations like staff invite)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
VITE_SITE_URL=http://localhost:3000

# AI Chat — wybierz JEDEN z dwóch:
# Opcja 1: Lokalny Ollama (bez limitów, bezpłatny)
OLLAMA_ENDPOINT=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
# Opcja 2: Groq Cloud (darmowy, ale limitowany)
# GROQ_API_KEY=gsk_your-groq-api-key
# GROQ_MODEL=llama-3.1-8b-instant

# WhatsApp (optional — for production)
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_VERIFY_TOKEN=
