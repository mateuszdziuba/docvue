# Supabase Configuration
# Server-side (server functions, SSR)
SUPABASE_URL=your-project-url
SUPABASE_ANON_KEY=your-anon-key

# Client-side (browser, must be prefixed with VITE_)
VITE_SUPABASE_URL=your-project-url
VITE_SUPABASE_ANON_KEY=your-anon-key

# Service Role Key (for admin operations like staff invite)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Publiczny adres aplikacji (linki w zaproszeniach). W produkcji ustaw domenę —
# kod ignoruje localhost i używa wtedy origin żądania.
VITE_SITE_URL=https://your-domain.example

# AI Chat — wybierz JEDEN z poniższych:
# Opcja 1: Google Gemini (darmowy, 60 req/min, https://aistudio.google.com/apikey)
GEMINI_API_KEY=AIza_your-gemini-api-key
# Opcja 2: Lokalny Ollama
# OLLAMA_ENDPOINT=http://localhost:11434
# OLLAMA_MODEL=llama3.1:8b
# Opcja 3: Groq Cloud
# GROQ_API_KEY=gsk_your-groq-api-key
# GROQ_MODEL=llama-3.1-8b-instant

# WhatsApp (optional — for production)
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_APP_SECRET=   # wymagany: weryfikacja podpisu X-Hub-Signature-256 webhooka
