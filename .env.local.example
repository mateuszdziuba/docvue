# Supabase Configuration
# Server-side (server functions, SSR)
SUPABASE_URL=your-project-url
SUPABASE_ANON_KEY=your-anon-key

# Client-side (browser, must be prefixed with VITE_)
VITE_SUPABASE_URL=your-project-url
VITE_SUPABASE_ANON_KEY=your-anon-key

# Service Role Key (for admin operations like staff invite)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
VITE_SITE_URL=http://localhost:3000

# AI Chat — Groq (free tier, https://console.groq.com/keys)
GROQ_API_KEY=gsk_your-groq-api-key
GROQ_MODEL=llama-3.1-70b-versatile

# WhatsApp (optional — for production)
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_VERIFY_TOKEN=
